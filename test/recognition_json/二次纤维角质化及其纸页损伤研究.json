          "label": "equ",
          "bbox": [
            172,
            493,
            450,
            524
          ],
          "text": "$$D _ { t } = \\frac { W R V _ { t } ^ { 1 } - W R V _ { t } ^ { 1 } } { W R V _ { t } } = 1 - \\frac { W R V _ { t } } { W R V _ { t } } , \\, . . . . . . . . . . \\quad( 5 . 5 )$$",
          "reading_order": 12,
          "tags": []
        },
